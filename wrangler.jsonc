
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "d1-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",

  "observability": {
    "enabled": true
  },

  "assets": {
  "directory": "./frontend/dist",
  "binding": "ASSETS"
  },

  "upload_source_maps": true,

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unit_analyzer",
      "database_id": "3a947304-679a-4a5d-983a-43d57eafca29",
	  "preview_database_id": "3a947304-679a-4a5d-983a-43d57eafca29"
    }
  ]
}